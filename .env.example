# Development only. Never reuse a deployed password.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-unique-local-password
# Native execution: set these to YOUR local PostgreSQL/PostGIS connection URLs.
# DATABASE_URL=postgresql+psycopg://xerxes:URL_ENCODED_PASSWORD@127.0.0.1:55432/xerxes
# TEST_DATABASE_URL=postgresql+psycopg://xerxes:URL_ENCODED_PASSWORD@127.0.0.1:55432/xerxes_test
# Docker Compose constructs its connection from individual fields; no URL encoding is needed there.
# Optional public browser key, restricted to Maps JavaScript API and allowed website referrers.
# Native Next.js: set this in apps/web/.env.local; Compose: set it in the root .env.
# GOOGLE_MAPS_BROWSER_KEY=
