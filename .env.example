# Development only. Never reuse a deployed password.
APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-unique-local-password
# Native execution: set these to YOUR local PostgreSQL/PostGIS connection URLs.
# DATABASE_URL=postgresql+psycopg://xerxes:URL_ENCODED_PASSWORD@127.0.0.1:55432/xerxes
# TEST_DATABASE_URL=postgresql+psycopg://xerxes:URL_ENCODED_PASSWORD@127.0.0.1:55432/xerxes_test
# Docker Compose constructs its connection from individual fields; no URL encoding is needed there.
# Optional public browser key, restricted to Maps JavaScript API and allowed website referrers.
# Native Next.js: set this in apps/web/.env.local; Compose: set it in the root .env.
# GOOGLE_MAPS_BROWSER_KEY=

# Native private development media storage; never place this under apps/web/public.
EVIDENCE_STORAGE_PROVIDER=filesystem
EVIDENCE_STORAGE_PATH=.local/evidence
PUBLIC_MEDIA_STORAGE_PROVIDER=filesystem
PUBLIC_MEDIA_STORAGE_PATH=.local/published
# Browser origins for reviewer login/CSRF. Use only explicit HTTPS origins in production.
APP_PUBLIC_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reviewed-activity public grid width in projected metres: 1000, 2000 or 5000.
PUBLIC_GRID_METERS=2000
# Create reviewer accounts explicitly with python -m xerxes_api.auth_seed --username YOUR_NAME.
# Passwords are prompted; never add moderator credentials here.
# Optional absolute executable paths if FFmpeg/ffprobe are not on PATH.
# FFMPEG_PATH=C:/path/to/ffmpeg.exe
# FFPROBE_PATH=C:/path/to/ffprobe.exe
